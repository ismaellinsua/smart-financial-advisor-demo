{
	admin off
	# The host (Render, a load balancer…) terminates HTTPS and forwards plain HTTP to $PORT.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# Only the app itself may frame its pages (Streamlit shows tickets in a same-origin frame): no clickjacking.
		X-Frame-Options "SAMEORIGIN"
		# Everything the app loads comes from itself (fonts and icons included): nothing can be fetched from or sent to
		# another site. Streamlit needs inline scripts and styles, so a stricter script-src is not possible.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# Stripe's signed notices go to the small webhook service; everything else to Streamlit.
	handle /stripe/webhook {
		request_body {
			max_size 512KB
		}
		reverse_proxy 127.0.0.1:8502
	}
	# The sign-in cookie, written by the server so page scripts cannot read it (ops/deploy/sessions.py).
	handle /_nk/sesion {
		request_body {
			max_size 1KB
		}
		reverse_proxy 127.0.0.1:8503
	}
	handle {
		reverse_proxy 127.0.0.1:8501
	}
}
