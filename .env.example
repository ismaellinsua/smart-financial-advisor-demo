# Every setting NirKanA reads (generated by `python -m core.config` from sales_manager/core/config.py).
# In Streamlit Secrets use the lower-case name; as environment variables, the upper-case one.
# Never commit real values: copy this file to .env, which git ignores.

# ---- La app
# PostgreSQL (p. ej. Neon) donde viven los datos. Sin ella, un archivo SQLite local. (secreto)
DATABASE_URL=
# 1 en servidores cuyo disco se borra al desplegar: sin database_url no arrancan.
REQUIRE_DATABASE=
# Conexiones por base de datos que mantiene cada servidor (1-50).
DB_POOL_SIZE=5
# Detalle del registro del servidor: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
# Prueba de propiedad al crear el primer administrador en una app publicada. (secreto)
APP_PASSWORD=
# true para servir varios negocios desde una app y una base de datos.
MULTI_TENANT=
# Contraseña del panel ?operador (modo varios negocios). (secreto)
OPERATOR_PASSWORD=
# Clave de verificación en dos pasos del panel ?operador. (secreto)
OPERATOR_TOTP_SECRET=
# Servidor SMTP para avisos, recordatorios y recuperar la contraseña.
SMTP_HOST=
# Puerto SMTP (587 con STARTTLS).
SMTP_PORT=587
# Usuario SMTP.
SMTP_USER=
# Contraseña SMTP (en Gmail, una contraseña de aplicación). (secreto)
SMTP_PASSWORD=
# Remitente visible, p. ej. «NirKanA <nirkana.oficial@gmail.com>».
SMTP_FROM=
# Clave secreta de Stripe; sin ella y stripe_price_id no se cobra a nadie. (secreto)
STRIPE_SECRET_KEY=
# Precio (price_…) de la suscripción en Stripe.
STRIPE_PRICE_ID=
# Secreto de firma del webhook de Stripe (whsec_…). (secreto)
STRIPE_WEBHOOK_SECRET=
# API de Stripe; solo se cambia para probar con stripe-mock.
STRIPE_API_BASE=https://api.stripe.com/v1
# Días de prueba gratis de un negocio nuevo (0-365).
TRIAL_DAYS=30
# Dirección pública de la app, para volver de Stripe Checkout.
APP_URL=
# Puerto interno del servicio de webhooks.
WEBHOOK_PORT=8502

# ---- Copias, avisos y vigilancia (ops/)
# Bases de datos a copiar, una por línea: nombre=postgresql://… (secreto)
BACKUP_DATABASES=
# Frase con la que se cifran las copias de seguridad. (secreto)
BACKUP_PASSPHRASE=
# PostgreSQL de pruebas donde ensayar la restauración de una copia. (secreto)
RESTORE_URL=
# Bases de datos a las que enviar avisos (por defecto, las de las copias). (secreto)
NOTIFY_DATABASES=
# Email del operador para avisos de caídas y resúmenes.
OPERATOR_EMAIL=
# Direcciones a vigilar, una por línea.
UPTIME_URLS=
# Rehacer solo una parte de las capturas (p. ej. autonomo).
CAPTURAS_SOLO=

# ---- Pruebas
# PostgreSQL desechable para las pruebas. (secreto)
TEST_DATABASE_URL=
# Chromium para las pruebas en navegador y las capturas.
E2E_CHROMIUM=
# stripe-mock local para comprobar las llamadas a Stripe.
STRIPE_MOCK_URL=
